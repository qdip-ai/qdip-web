FROM node:22-bookworm-slim
WORKDIR /workspace
ENV CI=true
RUN npm install -g pnpm@10.22.0
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec eslint --max-warnings=0 'src/app/[locale]/admin/applications/page.tsx' 'src/app/[locale]/plugins/[name]/page.vitest.test.tsx' 'src/app/api/observatory/admin/plugins/[name]/route.ts' 'src/app/api/observatory/admin/plugins/[name]/route.vitest.test.ts' 'src/app/api/observatory/admin/plugins/[name]/security/approve/route.ts' 'src/app/api/observatory/admin/plugins/[name]/security/approve/route.vitest.test.ts' 'src/app/api/observatory/admin/plugins/route.ts' 'src/components/observatory/application-publication-controls.tsx' 'src/components/observatory/observatory-plugin-admin.tsx' 'src/components/observatory/observatory-plugin-admin.vitest.test.tsx' 'src/components/observatory/observatory-plugin-inline-edit.vitest.test.tsx' 'src/lib/observatory-plugin-catalog.ts' 'src/lib/observatory-plugin-editorial.ts' 'src/lib/observatory-plugin-editorial.vitest.test.ts' 'src/lib/observatory-plugin-launch.ts' 'src/lib/observatory-plugin-launch.vitest.test.ts' 'src/lib/observatory-sdk-catalog.vitest.test.ts' && \
    pnpm exec prettier --check 'e2e/independent-application-publication.spec.ts' 'e2e/observatory-plugin-registration.spec.ts' 'e2e/yara-rename.spec.ts' 'src/app/[locale]/admin/applications/page.tsx' 'src/app/[locale]/plugins/[name]/page.vitest.test.tsx' 'src/app/api/observatory/admin/plugins/[name]/route.ts' 'src/app/api/observatory/admin/plugins/[name]/route.vitest.test.ts' 'src/app/api/observatory/admin/plugins/[name]/security/approve/route.ts' 'src/app/api/observatory/admin/plugins/[name]/security/approve/route.vitest.test.ts' 'src/app/api/observatory/admin/plugins/route.ts' 'src/components/observatory/application-publication-controls.tsx' 'src/components/observatory/observatory-plugin-admin.tsx' 'src/components/observatory/observatory-plugin-admin.vitest.test.tsx' 'src/components/observatory/observatory-plugin-inline-edit.vitest.test.tsx' 'src/lib/observatory-plugin-catalog.ts' 'src/lib/observatory-plugin-editorial.ts' 'src/lib/observatory-plugin-editorial.vitest.test.ts' 'src/lib/observatory-plugin-launch.ts' 'src/lib/observatory-plugin-launch.vitest.test.ts' 'src/lib/observatory-sdk-catalog.vitest.test.ts' && \
    pnpm typecheck && \
    pnpm exec vitest run 'src/app/[locale]/plugins/[name]/page.vitest.test.tsx' 'src/app/api/observatory/admin/plugins/[name]/route.vitest.test.ts' 'src/app/api/observatory/admin/plugins/[name]/security/approve/route.vitest.test.ts' 'src/components/observatory/observatory-plugin-admin.vitest.test.tsx' 'src/components/observatory/observatory-plugin-inline-edit.vitest.test.tsx' 'src/lib/observatory-plugin-editorial.vitest.test.ts' 'src/lib/observatory-plugin-launch.vitest.test.ts' 'src/lib/observatory-sdk-catalog.vitest.test.ts'
CMD ["node", "-e", "require('node:http').createServer((_,r)=>r.end('sandbox')).listen(8080,'0.0.0.0')"]

{
  "name": "@qdip/client",
  "version": "0.2.0",
  "description": "Server-side Node.js client for QDIP remote decision capabilities",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.uk.md",
    "README.pl.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "license": "UNLICENSED",
  "private": false
}
